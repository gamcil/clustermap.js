{
  "name": "clinker",
  "version": "0.0.0",
  "description": "Visualisations of gene cluster homology",
  "type": "module",
  "main": "./dist/clustermap.mjs",
  "exports": {
    ".": {
      "import": "./dist/clustermap.mjs"
    },
    "./editor": {
      "import": "./dist/editor.mjs"
    },
    "./editor/element": {
      "import": "./dist/editor.mjs"
    },
    "./editor.css": "./dist/editor.css",
    "./dist/clustermap.js": "./dist/clustermap.js",
    "./dist/clustermap.min.js": "./dist/clustermap.min.js"
  },
  "unpkg": "./dist/clustermap.min.js",
  "jsdelivr": "./dist/clustermap.min.js",
  "files": [
    "dist",
    "README.md",
    "TREE_SCHEMA.md",
    "ANNOTATION_SCHEMA.md",
    "LICENSE"
  ],
  "scripts": {
    "bench:rendering": "node bench/run.mjs",
    "build": "rollup --config",
    "import:clinker": "node scripts/import-clinker-render.mjs",
    "test": "node --test test/*.test.js",
    "test:baseline": "node --test test/baseline.test.js",
    "test:tree-browser": "node test/tree-browser.mjs"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.6.2",
    "d3": "^7.9.0",
    "d3-v1": "npm:d3@6.7.0",
    "rollup": "^2.79.2",
    "rollup-plugin-terser": "^7.0.2",
    "web-vitals": "5.1.0"
  }
}
